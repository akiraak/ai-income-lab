# 管理画面の設定。.env にコピーして埋める（.env は git 管理外）
# 資格情報（TT_*）はここに書かなくてよい。無ければ experiments/tastytrade-api-sample/.env を読む（AIL_TT_ENV_FILE で変更可）

# デモ: 1 で資格情報があっても本物には繋がず、モックのデータで全画面を出す（デザイン確認用）。0 で強制オフ。
# 未指定なら「資格情報が 1 つも無い」ときに自動でデモになる
# AIL_DEMO=1

# 面: loopback（既定。ループバックのみ）/ local（＋ RFC1918。WSL2 → Windows のブラウザ用）/ cloudflare（公開面。g3plus）
AIL_AUTH_MODE=local

# cloudflare のときだけ。3 つ全部そろわないと起動しない
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
CF_ACCESS_EMAIL=

AIL_BIND=127.0.0.1
AIL_PORT=3012

# 記録・監視ログ・ジョブ履歴の置き場（既定: dashboard/data。記録だけは既定でサンプルの out/ を読む）
# AIL_DATA_DIR=
# AIL_RECORDS_DIR=

# 監視の間隔（秒）と気配を見る銘柄
AIL_POLL_SECONDS=30
AIL_SYMBOL=SPY

# --- 本番の鍵（サンプルと同じ意味。既定はどちらも閉じている）---
# 本番の dry-run の鍵。⚠ 画面からは使わない（手動の dry-run は 2026-09-18 に外した。読むのは部品 devtools.run_step だけ）
# TT_ALLOW_PROD_DRY_RUN=0
# ⚠ 本番の発注の鍵（TT_ALLOW_PROD_ORDERS）は管理画面では使わない（2026-09-18 に手動の注文を外した。管理画面が開ける本番の鍵は取消だけ）
