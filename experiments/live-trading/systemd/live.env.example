# ~/.config/ai-income-lab/live.env の雛形（⚠ 利用者が自分で写して書く。git に入れない・chmod 600）。
# まず dry-run で 1 日回して timer-run.log を見てから、下の「本番の発注」に書き換える。
AIL_LIVE_TRADERS=T1,T2,T3
AIL_LIVE_ENV=prod
# --- 本番の dry-run（何もルーティングしない）---
AIL_LIVE_MODE=dry-run
AIL_LIVE_EXTRA=--allow-prod-dry-run
