# tastytrade API サンプルの設定。.env にコピーして埋める（.env は git 管理外）
# 値の作り方は README.md の「1. sandbox の資格情報を作る」を参照

# cert（sandbox）か prod（本番）。既定は cert
TT_ENV=cert

# sandbox account tool の「6 Create an OAuth application」で作った値
TT_CLIENT_ID=
TT_CLIENT_SECRET=
# 同じ画面の Create Grant で出る refresh token（公式は「無期限」）
TT_REFRESH_TOKEN=

# 空なら /customers/me/accounts の先頭を使う
TT_ACCOUNT_NUMBER=

# --- 手順 3・6 の気配（任意）------------------------------------------------
# sandbox は相場データを配信しない。公式が勧める「本番で読み、sandbox に発注する」形をとる。
# ここを埋めると手順 3・6 の気配だけ本番の資格情報で読む（発注には使わない）
TT_PROD_CLIENT_ID=
TT_PROD_CLIENT_SECRET=
TT_PROD_REFRESH_TOKEN=

# --- Phase 6（本番発注）------------------------------------------------------
# 本番で実弾を通すときだけ 1。これに加えて --i-know-this-is-real-money が要る
TT_ALLOW_PROD_ORDERS=0

# --- モック（配線の確認用。mock_server.py を立てたときだけ）------------------
# TT_REST_BASE=http://127.0.0.1:8765
# TT_ACCOUNT_STREAMER=ws://127.0.0.1:8766
